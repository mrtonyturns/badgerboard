# Supabase - get these from your Supabase project dashboard > Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic - stored as Netlify environment variable (NOT prefixed with VITE_)
# Set this in Netlify dashboard > Site Configuration > Environment Variables
ANTHROPIC_API_KEY=sk-ant-your-key-here

# DayFramer / GoHighLevel — Marketing tab integration (Netlify env vars)
# Agency-level Private Integration Token (pit-...), used to create marketing
# subaccounts and connect users. Needs scopes: locations write, users write.
GHL_AGENCY_API_KEY=pit-your-agency-token
# Optional — auto-discovered from existing locations when unset
GHL_COMPANY_ID=your-ghl-company-id
# App base for the embedded tools (default https://app.gohighlevel.com;
# swap for the white-label domain when ready)
DAYFRAMER_APP_URL=https://app.gohighlevel.com
# Optional — shared HMAC secret for the no-relogin SSO handoff; plain URLs
# are returned while unset
DAYFRAMER_SSO_SECRET=generate-a-long-random-secret

# Marketing Tier gating — OFF for the initial rollout (tools open to all
# signed-in users). Set 'true' AND flip MARKETING_GATING_ENABLED in
# src/lib/tiers.js to require the paid tier.
MARKETING_GATING_ENABLED=false

# Marketing Tier Stripe prices — only needed once gating is enabled.
# Created by `node stripe-setup.mjs <sk_live_key>`
STRIPE_PRICE_MARKETING_M=price_xxx
STRIPE_PRICE_MARKETING_Q=price_xxx
STRIPE_PRICE_MARKETING_S=price_xxx
STRIPE_PRICE_MARKETING_A=price_xxx
