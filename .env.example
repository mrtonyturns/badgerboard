# Supabase - get these from your Supabase project dashboard > Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic - stored as Netlify environment variable (NOT prefixed with VITE_)
# Set this in Netlify dashboard > Site Configuration > Environment Variables
ANTHROPIC_API_KEY=sk-ant-your-key-here

# DayFramer / GoHighLevel — Marketing Tier integration (Netlify env vars)
# Agency-level API key + company ID, used to create marketing subaccounts
GHL_AGENCY_API_KEY=your-ghl-agency-api-key
GHL_COMPANY_ID=your-ghl-company-id
# White-label app URL + shared HMAC secret for the no-relogin SSO handoff
DAYFRAMER_APP_URL=https://app.dayframer.com
DAYFRAMER_SSO_SECRET=generate-a-long-random-secret

# Marketing Tier Stripe prices — created by `node stripe-setup.mjs <sk_live_key>`
# (only needed until the IDs are baked into create-checkout-session.js)
STRIPE_PRICE_MARKETING_M=price_xxx
STRIPE_PRICE_MARKETING_Q=price_xxx
STRIPE_PRICE_MARKETING_S=price_xxx
STRIPE_PRICE_MARKETING_A=price_xxx
