{
  "name": "wi-political-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint src netlify/functions tests --no-inline-config --max-warnings 0",
    "lint:fix": "eslint src netlify/functions tests --fix",
    "preview": "vite preview",
    "test": "npm run lint && npm run test:unit",
    "test:integration": "node --experimental-vm-modules tests/security.test.js && node tests/full.test.js",
    "test:prospecting": "node tests/prospecting.test.mjs",
    "test:security": "node --experimental-vm-modules tests/security.test.js",
    "test:security:local": "APP_BASE_URL=http://localhost:8888 node --experimental-vm-modules tests/security.test.js",
    "test:unit": "node scripts/run-unit-tests.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@supabase/supabase-js": "^2.43.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.2.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.383.0",
    "maplibre-gl": "^5.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "pg": "^8.21.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.11"
  }
